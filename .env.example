# Copy to .env.local. No secrets are committed.
# Owner role: runs migrations. App role: used by app + worker (RLS enforced).
DATABASE_OWNER_URL=postgres://fc_owner:fc_owner_dev@localhost:5432/fc_dev
DATABASE_URL=postgres://fc_app:fc_app_dev@localhost:5432/fc_dev
APP_ORIGIN=http://localhost:3000

# fake | live. "fake" uses deterministic test providers and shows a "Sample providers" label.
PROVIDER_MODE=fake

# Live providers (server-side only). Leave empty in fake mode.
ANTHROPIC_API_KEY=
BRAVE_API_KEY=

# Live spend caps in USD (owner decision 2026-11-13).
LIVE_SESSION_CAP_USD=5
LIVE_TOTAL_CAP_USD=25
