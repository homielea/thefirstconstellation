{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "description": "One factual finding, stated plainly."
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids of the sources that support this claim, e.g. W1 or L2."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "claim",
          "sourceIds",
          "confidence"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Questions the sources could not answer."
    }
  },
  "required": [
    "summary",
    "findings",
    "gaps"
  ]
}
